# ==============================================================================
# PAKAINI - Environment Variables Template
# Salin file ini menjadi .env jika diperlukan, atau masukkan ke Railway Environment Variables
# ==============================================================================

# Port Web Server (Diisi otomatis oleh Railway jika di-deploy ke Railway)
PORT=8080

# SUPABASE POSTGRESQL CONNECTION STRING
# Dapatkan dari Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ALTERNATIF: Parameter Database Terpisah (Opsional jika DATABASE_URL tidak digunakan)
DB_HOST=db.yourproject.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=your_supabase_password

# Pengaturan WhatsApp Admin (Format Internasional: 628xxx)
ADMIN_WHATSAPP=6285143253217

# Environment Mode: production / development
APP_ENV=production
